APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
AIOS_OBSIDIAN_VAULT_PATH=
AIOS_OBSIDIAN_CONTEXT_MAX_CHARACTERS=24000
AIOS_ROADMAP_SCAN_INTERVAL_HOURS=24

# P9 local-first speech-to-text. Disabled until both paths are explicitly configured to local files.
# Keep whisper.cpp models outside Git, PostgreSQL, and managed project repositories.
AIOS_VOICE_STT_ENABLED=false
AIOS_VOICE_STT_BINARY_PATH=
AIOS_VOICE_STT_MODEL_PATH=
AIOS_VOICE_STT_TIMEOUT_SECONDS=120
AIOS_VOICE_STT_MAX_AUDIO_BYTES=10485760
AIOS_VOICE_STT_MAX_DURATION_SECONDS=60

# P0 database protection hardening: independent disaster-recovery backup subsystem, deliberately
# outside both the AIOS repository and any managed project workspace, and the AIOS-owned
# pre-execution recovery-point requirement enforced before Codex/Claude Code ever launches.
# See MASTER-PROMPT.md's "Database Protection" section.
AIOS_BACKUP_PATH=
AIOS_BACKUP_RETENTION_COUNT=20
AIOS_DATABASE_PROTECTION_FRESHNESS_SECONDS=3600
AIOS_DATABASE_RESTORE_LOCK_FILENAME=restore.lock
AIOS_DATABASE_CONNECTION=
AIOS_BACKUP_LEDGER_DATABASE=

# The Workflow Recovery Engineer edits only a disposable Git worktree of this repository, never
# the live checkout directly; AIOS independently validates/copies/commits any resulting change.
AIOS_RECOVERY_REPOSITORY_PATH=
